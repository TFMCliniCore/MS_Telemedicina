generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Videoconsulta {
  id              Int       @id @default(autoincrement())
  fecha           DateTime
  duracionMinutos Int       @default(30)
  motivo          String    @db.VarChar(500)
  estado          String    @default("PENDIENTE") @db.VarChar(20)  // PENDIENTE | EN_CURSO | COMPLETADA | CANCELADA
  eliminado       Boolean   @default(false)
  meetLink        String?   @db.VarChar(500)
  meetEventId     String?   @db.VarChar(255)
  pacienteId      Int
  clienteId       Int
  usuarioId       Int?
  sesiones        Sesion[]

  @@map("videoconsultas")
}

model Sesion {
  id              Int           @id @default(autoincrement())
  inicio          DateTime
  fin             DateTime?
  notas           String?       @db.VarChar(2000)
  estado          String        @default("ACTIVA") @db.VarChar(20)  // ACTIVA | FINALIZADA | INTERRUMPIDA
  eliminado       Boolean       @default(false)
  pacienteId      Int
  clienteId       Int
  usuarioId       Int?
  videoconsultaId Int?
  videoconsulta   Videoconsulta? @relation(fields: [videoconsultaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("sesiones")
}
